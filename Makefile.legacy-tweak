# 旧方案：把整包注入游戏的 theos tweak（形态 A）
#
# 已被"启动器 app + daemon + SpringBoard payload"取代（见 README-BUILD.md）。
# 保留它是因为 src/Game 里的偏移解析、W2S、引擎链校验这些代码在新形态里同样要用，
# 而这个 tweak 工程是验证那些代码最快的方式。
#
# 用法：make -f Makefile.legacy-tweak

ARCHS = arm64 arm64e
TARGET = iphone:clang:16.5:15.0

include $(THEOS)/makefiles/common.mk

TWEAK_NAME = ARCheat

# 只显示：骨骼 / 装备 / 物资
# Aim.mm 不在列表里 —— 这是刻意的：整个 dylib 不链接任何会调用 mem::wr 的目标文件，
# 二进制里根本不存在写游戏内存的代码路径（见 Docs/ESP-ONLY.md「零写入」）。
# Tweak.xm 必须带 m 后缀：它用到了 C++ 模板（mem::read），按 ObjC++ 编译才认 -std=c++17。
ARCheat_FILES = \
	src/Core/Stealth.mm \
	src/Game/UObject.mm \
	src/Game/World.mm \
	src/Game/Scene.mm \
	src/Render/ESP.mm \
	src/Render/Overlay.mm \
	Tweak.xm

# ImGui 核心 + Metal 后端：只有 vendor/imgui 存在时才编进来（本机没拉也不会挂）
ARCheat_FILES += $(wildcard \
	vendor/imgui/imgui.cpp \
	vendor/imgui/imgui_draw.cpp \
	vendor/imgui/imgui_tables.cpp \
	vendor/imgui/imgui_widgets.cpp \
	vendor/imgui/backends/imgui_impl_metal.mm)

ARCheat_CFLAGS = -fobjc-arc -std=c++17 -I. -Isrc -Ivendor -Ivendor/imgui -Ivendor/imgui/backends \
	-fvisibility=hidden -fno-unwind-tables -fno-asynchronous-unwind-tables
ARCheat_CCFLAGS = -fno-exceptions -fno-rtti
ARCheat_FRAMEWORKS = Foundation UIKit Metal MetalKit QuartzCore CoreGraphics
ARCheat_PRIVATE_FRAMEWORKS = IOSurface
# -x 去掉本地符号：dylib 里不该出现 hk_nextDrawable / aim_tick 这类可读名字
ARCheat_LDFLAGS = -Wl,-segalign,0x4000 -Wl,-x

# 隐蔽性开关（见 Docs/STEALTH.md）
#   AR_ALLOW_INLINE_HOOK=0  不提供匿名可执行内存分配路径（默认）
#   AR_XKEY                字符串 XOR 密钥
ARCheat_CFLAGS += -DAR_ALLOW_INLINE_HOOK=0 -DAR_XKEY=0x5B

include $(THEOS_MAKE_PATH)/tweak.mk
